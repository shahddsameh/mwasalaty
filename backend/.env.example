PORT=3000
CLIENT_URL=http://localhost:5173
# Public base URL of THIS backend, used to build the PayMob notification_url (webhook).
# For local testing PayMob must reach it publicly, e.g. an ngrok URL.
BACKEND_URL=http://localhost:3000

# PayMob (Accept) test credentials — from the PayMob dashboard. Never commit real values.
PAYMOB_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
PAYMOB_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE
PAYMOB_INTEGRATION_ID=YOUR_CARD_INTEGRATION_ID
PAYMOB_HMAC_SECRET=YOUR_HMAC_SECRET_HERE
# Only needed for refunds (legacy auth-token endpoint).
PAYMOB_API_KEY=YOUR_API_KEY_HERE

OTP_GRAPHQL_URL=http://localhost:8080/otp/routers/default/index/graphql

# Supabase Auth + favorite_places REST access. Use the same project as the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Backend-only alternative to SUPABASE_ANON_KEY. Never expose this in frontend/.env.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI fallback. Deterministic route parsing still works without this key.
# Groq, OpenAI-compatible Chat Completions API.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=8000
